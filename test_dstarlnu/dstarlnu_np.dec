#need to turn off mixing to prevent B0 from becoming an anti-B0
Define dm_incohMix_B0 0.0

## first argument is cartesian(0) or polar(1) representation of NP coefficients which
## are three consecutive numbers {id, Re(C), Im(C)} or {coeff id, |C|, Arg(C)}
## id==0 C_VL -- left-hand vector coefficient change from SM
## id==1 C_VR -- right-hand vector coefficient
## id==2 C_SL -- left-hand scalar coefficient
## id==3 C_SR -- right-hand scalar coefficient
## id==4 C_T

Decay B0
1   D*-    mu+   nu_M   BTODSTARLNUNPRH  0 0 -1 0 1 1 0;
#1   D*-    e+   nu_e   BTODSTARLNUNP 0 0 0 0 1 0.7 0 2 0 0 3 0 0;
#1   D*-    mu+   nu_M   BTODSTARLNUNP 0 0 -1 0 1 1 0;
#1   D*-    e+   nu_e   BTODSTARLNUNP 0 0 1.07 0 1 0.075 0 2 0 0 3 0 0;
Enddecay

Decay B-
#1  D*0    e-   anti-nu_M   BTODSTARLNUNP 0 0 -1 0 1 1 0;
#1   D*0    e-   anti-nu_e   BTODSTARLNUNP  0  0 0 0 1 0.5  0 2 0 0 3 0 0;
#1   D*0    e-   anti-nu_e   BTODSTARLNUNP 0  0 0 0 1 0.82 2 0 0 3 0 0;
#1   D*0    e-   anti-nu_e   BTODSTARLNUNP 0  0 1.08 0 1 0.090 0 2 0 -0.06 3 0 0.06;
Enddecay

Decay B+
#1   anti-D*0    e+   nu_e   BTODSTARLNUNP;
#1   anti-D*0    e+   nu_e   BTODSTARLNUNP 0 0 1.08 0 1 0.090 0 2 0 -0.06 3 0 0.06;
#1   anti-D*0    e+   nu_e   BTODSTARLNUNP 0 0 1.07 0 1 0.075 0 2 0 0 3 0 0;
#1   anti-D*0    e+   nu_M   BTODSTARLNUNP 0 0 -1 0 1 1 0; // for e+
#Newly created 
#1   anti-D*0    mu+   nu_M   BTODSTARLNUNP 0 0 -1 0 1 1 0; 
#1   anti-D*0    e+   nu_M   BTODSTARLNUNP 0 0 -1 0 1 0 0 2 -0.7 0 3 0.7 0 ;
Enddecay

Decay anti-B0
#1  D*+    mu-   anti-nu_mu   BTODSTARLNUNP;
#1   D*+    mu-   anti-nu_M  BTODSTARLNUNP  0 0 -1 0 1 1 0; 
#1   D*+    mu-   anti-nu_mu   BTODSTARLNUNP 0 0 0.08 0 1 0.090 0 2 0 -0.06 3 0 0.06;
#1   D*+    mu-   anti-nu_mu   BTODSTARLNUNP 0 0 1.07 0 1 0.075 0 2 0 0 3 0 0;
Enddecay

End
